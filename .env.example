# ==========================================
# Review Management SaaS - Backend Environment Variables
# ==========================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT: Never commit your actual .env file or production secrets to source control.

# Application Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Server Port (Default 5050 to avoid macOS AirPlay Receiver conflict on 5000)
PORT=5050

# Base URL for public links (QR landing pages, redirects)
APP_BASE_URL=http://localhost:5050

# Public application base URL for QR codes (Frontend Next.js app)
PUBLIC_APP_URL=http://localhost:3000

# Allowed CORS Origins (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Logging Level ('fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace')
LOG_LEVEL=info

# Database Connection (MongoDB URI)
# For local MongoDB: mongodb://localhost:27017/review_saas
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/review_saas?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/review_saas

# ------------------------------------------
# Authentication & Security Configuration (Phase 3)
# ------------------------------------------
OTP_SECRET=development_otp_hmac_secret_key_at_least_32_chars_long
SESSION_SECRET=development_session_secret_key_at_least_32_chars_long
SESSION_TTL_HOURS=168
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60
ENABLE_DEV_OTP_EXPOSURE=false
 
# ------------------------------------------
# Email & OTP Delivery Configuration (Nodemailer / ZeptoMail SMTP)
# ------------------------------------------
# Supported providers: 'mock' (dev/test only, logs to terminal) | 'smtp' (live emails)
EMAIL_PROVIDER=mock
# For Gmail: smtp.gmail.com | For ZeptoMail: smtp.zeptomail.in (or .com)
SMTP_HOST=smtp.gmail.com
# 587 (TLS) or 465 (SSL)
SMTP_PORT=587
SMTP_SECURE=false
# Gmail email address OR ZeptoMail username (usually 'emailapikey')
SMTP_USER=
# Gmail App Password OR ZeptoMail Send Mail Token
SMTP_PASS=
# Sender name and address (e.g., "Review SaaS <noreply@yourdomain.com>")
EMAIL_FROM="Review SaaS <noreply@example.com>"

# ------------------------------------------
# QR Campaigns & Storage Configuration (Phase 5)
# ------------------------------------------
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=uploads
MAX_UPLOAD_SIZE_BYTES=2097152

# ------------------------------------------
# AI Feedback Assistance Configuration (Phase 7)
# ------------------------------------------
# Supported providers: 'mock' (dev/test only) | 'gemini' | 'openai' | 'disabled'
AI_PROVIDER=disabled
AI_API_KEY=
AI_TIMEOUT_MS=10000

# ------------------------------------------
# Billing & Subscription Configuration (Phase 9 & 10)
# ------------------------------------------
# Supported providers: 'mock' (dev/test only) | 'razorpay' | 'disabled'
PAYMENT_PROVIDER=mock
ENABLE_DEV_MOCK_PAYMENTS=true
# Razorpay Credentials (Required when PAYMENT_PROVIDER=razorpay)
RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_SECRET=yourRazorpayKeySecretHere
RAZORPAY_WEBHOOK_SECRET=yourRazorpayWebhookSecretHere

# ------------------------------------------
# Super Admin Configuration
# ------------------------------------------
SUPER_ADMIN_EMAIL=admin@example.com
